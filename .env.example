# Template. Copy to .env.local (ignored by git) and fill in the values.
# NEVER put real values in this file: it is committed to the repository.
# On Vercel: Project → Settings → Environment Variables (same three).

# Data source: "mock" (in-memory, offline) or "supabase" (real backend).
DATA_SOURCE=supabase

# Supabase → Project Settings → API (or the "Connect" button).
# The NEXT_PUBLIC_-prefixed names suggested by the dashboard are accepted too.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# PUBLIC key only: "publishable" (sb_publishable_...) or legacy "anon" (eyJ...).
# Never the secret / service_role key.
SUPABASE_PUBLISHABLE_KEY=
