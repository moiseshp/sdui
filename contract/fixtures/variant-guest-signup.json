{
  "schemaVersion": "1.2.0",
  "screenId": "kfc_home",
  "layout": "default",
  "theme": "default",
  "header": {
    "id": "guest_signup_header",
    "type": "header_default",
    "version": 1,
    "props": {
      "position": "sticky",
      "variant": "default",
      "actions": {
        "user": { "onPress": [{ "type": "NAVIGATE", "payload": { "url": "/ingresar" } }] },
        "settings": { "onPress": [{ "type": "NAVIGATE", "payload": { "url": "/configuracion" } }] }
      }
    }
  },
  "sections": [
    {
      "id": "guest_signup_announcement",
      "type": "announcement_bar",
      "version": 1,
      "props": {
        "message": "Crea tu cuenta gratis y desbloquea las ofertas Solo por hoy",
        "variant": "dark",
        "isDismissible": false
      }
    },
    {
      "id": "guest_signup_welcome_coupon",
      "type": "coupon_card",
      "version": 1,
      "props": {
        "title": "10% en tu primer pedido",
        "description": "Crea tu cuenta en segundos y úsalo hoy mismo, en delivery o en tienda.",
        "code": "BIENVENIDO10",
        "validUntilLabel": "Válido en tu primer pedido",
        "badge": "BIENVENIDA",
        "cta": {
          "label": "Crear mi cuenta",
          "actions": { "onPress": [{ "type": "NAVIGATE", "payload": { "url": "/ingresar" } }] }
        }
      }
    },
    {
      "id": "guest_signup_benefits",
      "type": "promo_banner",
      "version": 1,
      "props": {
        "title": "Con tu cuenta, pides más rápido",
        "description": "Guarda tus favoritos y tu dirección, y recibe ofertas pensadas para ti.",
        "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/sections/para_ti_delivery.jpg",
        "badge": "BENEFICIOS",
        "actions": { "onPress": [{ "type": "NAVIGATE", "payload": { "url": "/ingresar" } }] }
      }
    },
    {
      "id": "guest_signup_hero",
      "type": "hero_banner",
      "version": 1,
      "props": {
        "items": [
          { "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/banners/mobile/dipeo.webp", "alt": "Mega Dipeo - Combo desde S/24.90" },
          { "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/banners/MOBILE_CYB_20260420.png", "alt": "Big Box - La caja que lo tiene todo" },
          { "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/banners/BANNER_LDHW_2_MOBILE.jpg", "alt": "Nuevos Krushers - Refréscate" }
        ],
        "viewportMode": "peek",
        "autoplay": true,
        "autoplayInterval": 5000,
        "showDots": true
      }
    },
    {
      "id": "guest_signup_most_chosen",
      "type": "featured_products",
      "version": 1,
      "props": {
        "title": "Los combos más elegidos 🔥",
        "layout": "carousel",
        "items": [
          { "id": "prod_001", "name": "Mega Familiar 15 Piezas", "description": "15 piezas de pollo + 3 papas grandes + ensalada + 1.5L bebida", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/products/mega-promo-8-piezas-202602160411187422.jpg", "price": "S/ 89.90", "originalPrice": "S/ 109.90", "badge": "-30%" },
          { "id": "prod_002", "name": "Big Box Original", "description": "2 piezas de pollo + papas + ensalada + bebida + postre", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/products/mega-promo-10-piezas-202602160411385589.jpg", "price": "S/ 24.90", "originalPrice": "S/ 27.90", "badge": "-15%" },
          { "id": "prod_003", "name": "Chicken Strips x6", "description": "6 strips crocantes + salsa BBQ o ranch", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/products/mega-promo-10-piezas-202602160411385589.jpg", "price": "S/ 29.90", "originalPrice": "S/ 37.90", "badge": "-20%" },
          { "id": "prod_004", "name": "Dúo Twister XL con papas", "description": "2 Twister XL + 2 papas medianas", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/products/duo-twister-xl-con-papas-202602160411547690.jpg", "price": "S/ 32.90", "originalPrice": "S/ 38.90", "badge": "-15%" }
        ]
      }
    }
  ],
  "meta": {
    "title": "KFC Perú - Inicio",
    "description": "Vista Enfoque registro: alternativa para quien navega sin sesión. Prioriza crear cuenta antes que los productos."
  }
}
