        "progressLabel": "Te faltan 550 puntos para subir a Platinum."
      }
    },
    {
      "id": "loyalty_picked_for_you",
      "type": "featured_products",
      "version": 1,
      "props": {
        "title": "Elegidos para ti ⭐",
        "layout": "carousel",
        "items": [
          { "id": "prod_002", "name": "Big Box Original", "description": "Suma 50 puntos Club", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/products/mega-promo-10-piezas-202602160411385589.jpg", "price": "S/ 24.90", "originalPrice": "S/ 27.90", "badge": "-15%" },
          { "id": "prod_004", "name": "Dúo Twister XL con papas", "description": "Suma 65 puntos Club", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/products/duo-twister-xl-con-papas-202602160411547690.jpg", "price": "S/ 32.90", "originalPrice": "S/ 38.90", "badge": "-15%" },
          { "id": "prod_001", "name": "Mega Familiar 15 Piezas", "description": "Suma 180 puntos Club", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/products/mega-promo-8-piezas-202602160411187422.jpg", "price": "S/ 89.90", "originalPrice": "S/ 109.90", "badge": "-30%" }
        ]
      }
    },
    {
      "id": "loyalty_favorites",
      "type": "featured_products",
      "version": 1,
      "props": {
        "title": "Tu lista de favoritos ❤️",
        "layout": "grid",
        "items": [
          { "id": "fav_001", "name": "Para ti", "description": "2 piezas de pollo + papas + bebida", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/sections/para_ti_delivery.jpg", "price": "S/ 18.90" },
          { "id": "fav_002", "name": "Twister XL", "description": "Twister XL + papas + bebida", "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/sections/twister_delivery.jpg", "price": "S/ 21.90" }
        ]
      }
    },
    {
      "id": "loyalty_today",
      "type": "promo_banner",
      "version": 1,
      "props": {
        "title": "Solo por hoy, exclusivo Club",
        "description": "Mega 8 Piezas a S/ 54.90 y sumas 180 puntos.",
        "imageUrl": "https://delosi-pidelo.s3.amazonaws.com/kfc/products/mega-promo-8-piezas-202602160411187422.jpg",
