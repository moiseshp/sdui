{
  "schemaVersion": "1.2.0",
  "screenId": "kfc_home",
  "layout": "default",
  "theme": "loyalty",
  "header": {
    "id": "loyalty_header",
    "type": "header_greeting",
    "version": 1,
    "props": {
      "title": "¡Hola, {{firstName}}!",
      "subtitle": "Miembro Club KFC Gold ★",
      "position": "sticky",
      "variant": "default",
      "actions": {
        "user": { "onPress": [{ "type": "NAVIGATE", "payload": { "url": "/ingresar" } }] },
        "settings": { "onPress": [{ "type": "NAVIGATE", "payload": { "url": "/configuracion" } }] }
      }
    }
  },
  "sections": [
    {
      "id": "loyalty_announcement",
      "type": "announcement_bar",
      "version": 1,
      "props": {
        "message": "★ Club KFC: este fin de semana sumas puntos dobles en todos tus pedidos",
        "variant": "light",
        "isDismissible": true
      }
    },
    {
      "id": "loyalty_status",
      "type": "loyalty_card",
      "version": 1,
      "props": {
        "tierLabel": "Club Gold",
        "pointsLabel": "2,450 pts",
